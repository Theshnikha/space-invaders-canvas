# Node / JavaScript
node_modules/
npm-debug.log*
yarn-error.log*

# Logs and runtime artifacts
*.log
jenkins-cli.jar

# Terraform local state and secrets
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
terraform/*.tfplan

# Ansible secrets (never commit SSH keys or vault passwords)
*.pem
*.key
ansible/.vault_pass
ansible/inventory/group_vars/vault.yml

# OS generated files
.DS_Store
Thumbs.db

# Environment files with secrets
.env
.env.*
!.env.example
